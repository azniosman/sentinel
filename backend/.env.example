# ============================================
# AI-SOC — Environment Variables
# ============================================
# Copy this file to .env and fill in the values you need.
# All settings are optional with sensible defaults.
#
#   cp .env.example .env
#
# ============================================


# ------ Application Settings ------

# Application name and version
APP_NAME=AI-SOC Backend
APP_VERSION=1.0.0

# Debug mode (set to false in production)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ------ Server Settings ------

# Server host (bind to 0.0.0.0 for all interfaces)
HOST=127.0.0.1

# Server port
PORT=8000

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173


# ------ Local LLM Settings (Ollama) ------

# Ollama host URL
OLLAMA_HOST=http://127.0.0.1:11434

# LLM model for analysis (must be installed in Ollama)
LLM_MODEL=llama3

# Embedding model (must be installed in Ollama or use sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM temperature (0.0 - 1.0)
LLM_TEMPERATURE=0.1

# Maximum tokens for LLM response
LLM_MAX_TOKENS=2048


# ------ Vector Database Settings ------

# Path to local vector database
VECTOR_STORE_PATH=./vector_store/chroma_db

# Collection name for threat intelligence
VECTOR_STORE_COLLECTION=threat_intelligence


# ------ Data Paths ------

# Base data directory
DATA_DIR=./data

# Threat intelligence datasets directory
THREAT_INTEL_DIR=./data/threat_intel

# Raw feeds directory
RAW_FEEDS_DIR=./data/raw_feeds


# ------ Network Analysis Settings ------

# Default network targets for scanning (comma-separated CIDR ranges)
DEFAULT_SCAN_TARGETS=192.168.1.0/24,10.0.0.0/24

# Scan timeout in seconds
SCAN_TIMEOUT=300

# Maximum concurrent scans
MAX_CONCURRENT_SCANS=5


# ------ Scheduler Settings ------

# Enable background scheduler
SCHEDULER_ENABLED=true

# CVE feed update interval (hours)
CVE_UPDATE_INTERVAL_HOURS=6

# Embedding refresh interval (hours)
EMBEDDING_UPDATE_INTERVAL_HOURS=12

# Network scan interval (hours)
NETWORK_SCAN_INTERVAL_HOURS=6

# Threat intelligence update interval (hours)
THREAT_INTEL_UPDATE_INTERVAL_HOURS=6


# ------ Security Settings ------

# Optional API key for authentication (leave empty to disable)
API_KEY=

# Encrypt data at rest (true/false)
ENCRYPT_DATA_AT_REST=false

# Encryption key (32-byte base64 encoded, required if ENCRYPT_DATA_AT_REST=true)
ENCRYPTION_KEY=


# ------ Rate Limiting ------

# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=60


# ------ WebSocket Settings ------

# WebSocket heartbeat interval (seconds)
WS_HEARTBEAT_INTERVAL=30
